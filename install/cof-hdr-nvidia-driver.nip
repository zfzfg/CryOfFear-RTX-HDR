<?xml version="1.0" encoding="utf-16"?>
<!--
  RTX HDR via the driver, no NVIDIA app needed. No image-quality forcing.

  Importing this file REPLACES the whole "Cry of Fear (HDR)" driver profile.
  It does not merge. Every setting you want must therefore be in this one file -
  do not import two of these expecting the results to add up.

  nvidiaProfileInspector.exe -silentImport <this file>
-->
<ArrayOfProfile>
  <Profile>
    <ProfileName>Cry of Fear (HDR)</ProfileName>
    <Executeables>
      <string>cof.exe</string>
    </Executeables>
    <Settings>
      <!-- 0x00432F84 RTX HDR Driver Flags = 2 (VeryHigh debanding) -->
      <ProfileSetting>
        <SettingNameInfo />
        <SettingID>4403076</SettingID>
        <SettingValue>2</SettingValue>
        <ValueType>Dword</ValueType>
      </ProfileSetting>
      <!-- 0x00980896 Toggle to Enable/Disable Game Filters = 1 -->
      <ProfileSetting>
        <SettingNameInfo>Toggle to Enable/Disable Game Filters</SettingNameInfo>
        <SettingID>9963670</SettingID>
        <SettingValue>1</SettingValue>
        <ValueType>Dword</ValueType>
      </ProfileSetting>
      <!-- 0x00DD48FB Enable TrueHDR Feature = 1 -->
      <ProfileSetting>
        <SettingNameInfo>Enable TrueHDR Feature</SettingNameInfo>
        <SettingID>14502139</SettingID>
        <SettingValue>1</SettingValue>
        <ValueType>Dword</ValueType>
      </ProfileSetting>
      <!-- 0x1077A11A Undocumented TrueHDR setting = 1 -->
      <ProfileSetting>
        <SettingNameInfo />
        <SettingID>276275482</SettingID>
        <SettingValue>1</SettingValue>
        <ValueType>Dword</ValueType>
      </ProfileSetting>
      <!-- 0x20D690F8 Vulkan/OpenGL present method = 1 (layered on DXGI swapchain) -->
      <ProfileSetting>
        <SettingNameInfo>Vulkan/OpenGL present method</SettingNameInfo>
        <SettingID>550932728</SettingID>
        <SettingValue>1</SettingValue>
        <ValueType>Dword</ValueType>
      </ProfileSetting>
    </Settings>
    <ExecutableFindFiles />
  </Profile>
</ArrayOfProfile>
